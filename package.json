{
  "name": "abinzhao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "node scripts/package-harness.mjs && vitepress build docs",
    "preview": "vitepress preview docs",
    "check": "vue-tsc --noEmit -p docs/tsconfig.json && tsc --noEmit -p docs/tsconfig.worker.json",
    "test": "vitest run tests/ && node --test examples/agent-harness/test/*.test.mjs",
    "sync:projects": "node scripts/sync-github-projects.mjs",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "@lucide/vue": "^1.57.0",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.17.0",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "3.5.44",
    "vue-tsc": "3.3.12",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "markdown-it": "14.1.0"
  }
}
