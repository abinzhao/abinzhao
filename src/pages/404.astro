---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/site";

const recoveryLinks = [
  { href: withBase("/"), label: "首页" },
  { href: withBase("/projects/"), label: "项目" },
  { href: withBase("/blog/"), label: "博客" },
  { href: withBase("/playground/"), label: "实验室" },
] as const;
---

<BaseLayout
  title="信号丢失｜ZJB.DEV"
  description="请求的页面没有找到，请从站点主要入口继续浏览。"
>
  <section class="lost-signal">
    <div class="black-hole" aria-hidden="true">
      <div class="black-hole__core"></div>
      <div class="black-hole__ring"></div>
      <div class="particle-field">
        {Array.from({ length: 14 }, (_, index) => <span style={`--i:${index}`}></span>)}
      </div>
    </div>

    <div class="lost-signal__copy">
      <p>ERROR / 404</p>
      <h1>信号丢失</h1>
      <p>这条轨道没有返回内容。选择一个已知坐标，继续探索。</p>
      <nav aria-label="页面恢复入口">
        {
          recoveryLinks.map((link) => (
            <a href={link.href}>
              {link.label}<span aria-hidden="true">→</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .lost-signal {
    display: grid;
    grid-template-columns: minmax(18rem, 0.9fr) minmax(0, 1fr);
    min-height: calc(100vh - 4.5rem);
    width: min(100% - 2rem, 76rem);
    align-items: center;
    margin-inline: auto;
    padding: 3rem 0 5rem;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .black-hole {
    position: relative;
    width: min(100%, 28rem);
    aspect-ratio: 1;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 50%;
    background:
      radial-gradient(circle at center, #010106 0 18%, transparent 19%),
      radial-gradient(circle at center, transparent 0 25%, rgba(124, 109, 255, 0.2) 27%, transparent 40%),
      radial-gradient(circle at center, rgba(255, 118, 83, 0.08), transparent 67%);
  }

  .black-hole__core,
  .black-hole__ring {
    position: absolute;
    inset: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .black-hole__core {
    width: 30%;
    aspect-ratio: 1;
    background: #010106;
    box-shadow:
      0 0 2rem 0.35rem rgba(124, 109, 255, 0.35),
      0 0 5rem 1rem rgba(255, 118, 83, 0.18);
  }

  .black-hole__ring {
    width: 58%;
    aspect-ratio: 1;
    border: 2px solid rgba(245, 207, 100, 0.68);
    box-shadow: 0 0 1.5rem rgba(255, 118, 83, 0.7);
    transform: translate(-50%, -50%) rotate(-18deg) scaleY(0.34);
  }

  .particle-field {
    position: absolute;
    inset: 0;
  }

  .particle-field span {
    --angle: calc(var(--i) * 25.7deg);
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(2px + mod(var(--i), 3) * 1px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-focus);
    box-shadow: 0 0 0.65rem var(--color-focus);
    transform:
      rotate(var(--angle))
      translateX(calc(6.5rem + mod(var(--i), 5) * 1.15rem));
    transform-origin: 0 0;
  }

  .lost-signal__copy > p:first-child {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(3.5rem, 9vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.06em;
  }

  .lost-signal__copy > p:not(:first-child) {
    max-width: 32rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2.5rem;
    gap: 0.75rem;
  }

  nav a {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    text-decoration: none;
  }

  nav a:hover {
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .particle-field {
      animation: particle-inhale 12s linear infinite;
    }

    .black-hole__ring {
      animation: ring-pulse 4s ease-in-out infinite;
    }
  }

  @keyframes particle-inhale {
    to {
      transform: rotate(360deg) scale(0.88);
    }
  }

  @keyframes ring-pulse {
    50% {
      opacity: 0.68;
      transform: translate(-50%, -50%) rotate(-15deg) scaleY(0.3);
    }
  }

  @media (max-width: 47.99rem) {
    .lost-signal {
      grid-template-columns: 1fr;
      padding-top: 2rem;
    }

    .black-hole {
      width: min(78vw, 22rem);
    }

    nav {
      grid-template-columns: 1fr;
    }
  }
</style>
