---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";
import ArticlePager from "@/components/blog/ArticlePager.astro";
import ArticleToc from "@/components/blog/ArticleToc.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAdjacentEntries, getReadingMinutes } from "@/lib/content";
import { buildBlogPostingJsonLd } from "@/lib/seo";
import { withBase } from "@/lib/site";
import "@/styles/glass-content.css";

export async function getStaticPaths() {
  const entries = (await getCollection(
    "blog",
    ({ data }) => !data.draft,
  )).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const sortableEntries = entries.map((entry) => ({
    ...entry,
    slug: entry.data.slug,
  }));

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      adjacent: getAdjacentEntries(sortableEntries, entry.data.slug),
      related: entries
        .filter(
          (candidate) =>
            candidate.data.slug !== entry.data.slug &&
            candidate.data.tags.some((tag) => entry.data.tags.includes(tag)),
        )
        .slice(0, 2),
    },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
  adjacent: {
    previous?: CollectionEntry<"blog">;
    next?: CollectionEntry<"blog">;
  };
  related: CollectionEntry<"blog">[];
}

const { entry, adjacent, related }: Props = Astro.props;
const { Content, headings } = await render(entry);
const { title, slug, summary, date, updatedAt, category, subcategory, tags } =
  entry.data;
const readingMinutes = getReadingMinutes(entry.body ?? "");
const jsonLd = buildBlogPostingJsonLd({
  title,
  summary,
  path: `/blog/${slug}/`,
  date,
  updatedAt,
  tags,
});
---

<BaseLayout
  title={`${title}｜博客｜ZJB.DEV`}
  description={summary}
  canonicalPath={`/blog/${slug}/`}
  jsonLd={jsonLd}
  cosmicVariant="article"
>
  <div class="reading-progress" data-reading-progress aria-hidden="true">
    <span data-reading-progress-bar></span>
  </div>
  <article class="article-detail">
    <header class="article-header">
      <a class="article-header__back" href={withBase("/blog/")}>← 返回博客</a>
      <p class="blog-eyebrow">
        {category}{subcategory ? ` / ${subcategory}` : ""}
      </p>
      <h1>{title}</h1>
      <p class="article-header__summary">{summary}</p>
      <div class="article-header__meta">
        <time datetime={date.toISOString()}>
          {
            new Intl.DateTimeFormat("zh-CN", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            }).format(date)
          }
        </time>
        <span>预计阅读 {readingMinutes} 分钟</span>
      </div>
      <ul class="article-tags" aria-label="文章标签">
        {
          tags.map((tag) => (
            <li>
              <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <div class="article-layout">
      <div class="article-body">
        <Content />
      </div>
      <ArticleToc headings={headings} />
    </div>

    <section class="article-feedback" aria-labelledby="article-feedback-title">
      <p id="article-feedback-title">这篇文章对你有帮助吗？</p>
      <button type="button" data-article-feedback>这个观点改变了我的想法</button>
      <span data-feedback-status aria-live="polite"></span>
    </section>

    {
      related.length > 0 && (
        <section class="article-related" aria-labelledby="article-related-title">
          <h2 id="article-related-title">继续阅读</h2>
          <ul>
            {related.map((item) => (
              <li>
                <a href={withBase(`/blog/${item.data.slug}/`)}>
                  {item.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <ArticlePager {...adjacent} />
  </article>

  <script>
    import "@/scripts/article";
  </script>
</BaseLayout>
