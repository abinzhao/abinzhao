---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/cinematic-home.css";
---

<BaseLayout title="About Abin | abinzhao" description="How Abin works across frontend, HarmonyOS, and AI." canonicalPath="/en/about/" cosmicVariant="about" locale="en">
  <article class="about-page">
    <header class="about-hero">
      <p class="about-hero__eyebrow">ABOUT / ABIN</p>
      <h1>Engineering with clarity and sincerity.</h1>
      <p>I focus on frontend systems, HarmonyOS experiences, and AI-native applications. “纯爱掌门人” is a reminder to treat technology, creation, and long-term relationships seriously.</p>
    </header>
    <div class="about-layout">
      <section class="about-section">
        <div class="about-section__heading"><p>01 / PRINCIPLES</p><h2>How I work</h2></div>
        <div class="signal-grid">
          <article class="signal-card"><small>CLARITY</small><h3>Start from facts</h3><p>Separate confirmed evidence from assumptions.</p></article>
          <article class="signal-card"><small>CRAFT</small><h3>Build the real thing</h3><p>Move from demos into verifiable product behavior.</p></article>
          <article class="signal-card"><small>BOUNDARIES</small><h3>State limits</h3><p>Make constraints and fallback behavior visible.</p></article>
          <article class="signal-card"><small>LONG TERM</small><h3>Keep it maintainable</h3><p>Prefer portable, file-based engineering assets.</p></article>
        </div>
      </section>
      <section class="about-section">
        <div class="about-section__heading"><p>02 / CONTACT</p><h2>Stay in touch</h2></div>
        <p><a class="cinematic-button" href="https://github.com/abinzhao">GitHub ↗</a> <a class="cinematic-button" href="mailto:abin_v@163.com">Email ↗</a></p>
      </section>
    </div>
  </article>
</BaseLayout>
