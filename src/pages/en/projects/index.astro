---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortProjects } from "@/lib/content";
import { withBase } from "@/lib/site";

const projects = sortProjects(
  (await getCollection("projects", ({ data }) => !data.draft)).map((entry) => ({
    ...entry,
    slug: entry.data.slug,
  })),
);
---

<BaseLayout title="Projects | abinzhao" description="Public engineering work by Abin." canonicalPath="/en/projects/" cosmicVariant="projects" locale="en">
  <div class="projects-layout">
    <header class="compact-page-header">
      <div>
        <p class="compact-page-header__eyebrow">PROJECT ARCHIVE</p>
        <h1>Projects</h1>
      </div>
      <p class="compact-page-header__summary">
        {projects.length} public projects built from real constraints and verifiable source material.
      </p>
    </header>
    <section class="projects-section">
      <div class="projects-section__heading"><p>SELECTED WORK</p><h2>Engineering evidence</h2></div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card" data-tilt>
            <div class="project-card__meta">{project.data.status.toUpperCase()} / {project.data.year}</div>
            <h2><a href={withBase(`/projects/${project.data.slug}/`)}>{project.data.title}</a></h2>
            <p>{project.data.summary}</p>
            <div class="project-card__tags">{project.data.tags.join(" · ")}</div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
