---
import { getCollection } from "astro:content";
import ExperimentCard from "@/components/playground/ExperimentCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/playground.css";

const experiments = (await getCollection("playground", ({ data }) => !data.draft))
  .sort(
    (left, right) =>
      Number(right.data.featured) - Number(left.data.featured) ||
      right.data.date.getTime() - left.data.date.getTime() ||
      left.data.title.localeCompare(right.data.title, "zh-CN"),
  );
---

<BaseLayout title="Lab | abinzhao" description="Runnable technical experiments by Abin." canonicalPath="/en/playground/" cosmicVariant="playground" locale="en">
  <main class="playground-index">
    <header class="playground-workbench-header">
      <div>
        <p class="playground-eyebrow">OPEN LAB / {String(experiments.length).padStart(2, "0")}</p>
        <h1>Lab</h1>
      </div>
      <p>Live systems for graphics, physics, and interaction, with documented mechanisms and fallback behavior.</p>
    </header>

    <section class="playground-catalog" aria-labelledby="experiment-list-title">
      <header class="playground-catalog__heading">
        <p>LIVE TRANSMISSIONS</p>
        <h2 id="experiment-list-title">Choose a system to run</h2>
      </header>
      <div class="experiment-grid">
        {experiments.map((experiment, index) => (
          <ExperimentCard experiment={experiment} index={index} locale="en" />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
