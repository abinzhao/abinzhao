---
import { getCollection } from "astro:content";
import RedirectPage from "@/components/global/RedirectPage.astro";

export async function getStaticPaths() {
  const projects = await getCollection(
    "projects",
    ({ data }) => !data.draft,
  );

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: {
      to: `/projects/${project.data.slug}/`,
      label: `项目“${project.data.title}”`,
    },
  }));
}

interface Props {
  to: string;
  label: string;
}

const { to, label } = Astro.props;
---

<RedirectPage to={to} label={label} />
