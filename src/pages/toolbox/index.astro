---
import ToolCard from "@/components/toolbox/ToolCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { toolboxGroups, toolboxTools } from "@/lib/toolbox/registry";
import "@/styles/cinematic-toolbox.css";
---

<BaseLayout
  title="工具箱｜abinzhao"
  description="开发、文本、设计与 AI 提效工具。所有输入默认只在浏览器本地处理。"
  canonicalPath="/toolbox/"
  cosmicVariant="toolbox"
>
  <div class="toolbox-page">
    <header class="toolbox-hero">
      <p>LOCAL-FIRST / ZERO UPLOAD</p>
      <h1>把常用处理，留在<span>浏览器本地。</span></h1>
      <p>
        开发、文本、设计与 AI 辅助工具统一收进一个安静的工作台。输入默认不上传、不保存，每个工具都有可直接访问的独立页面。
      </p>
    </header>

    <label class="toolbox-search">
      <span class="sr-only">搜索工具</span>
      <input
        type="search"
        name="tool-search"
        placeholder="搜索工具，例如 JSON、颜色、Prompt…"
        data-tool-search
      />
    </label>

    {
      toolboxGroups.map((group) => {
        const tools = toolboxTools.filter((tool) => tool.group === group.id);
        return (
          <section class="toolbox-group" aria-labelledby={`toolbox-${group.id}`}>
            <div class="toolbox-group__head">
              <h2 id={`toolbox-${group.id}`}>{group.label}</h2>
              <p>{group.description}</p>
            </div>
            <div class="toolbox-grid">
              {tools.map((tool) => <ToolCard tool={tool} />)}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-tool-search]");
  input?.addEventListener("input", () => {
    const query = input.value.trim().toLocaleLowerCase("zh-CN");
    document.querySelectorAll<HTMLElement>(".tool-card").forEach((card) => {
      card.hidden = !card.textContent?.toLocaleLowerCase("zh-CN").includes(query);
    });
  });
</script>
