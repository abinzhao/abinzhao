---
import ToolCard from "@/components/toolbox/ToolCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { toolboxGroups, toolboxTools } from "@/lib/toolbox/registry";
import "@/styles/cinematic-toolbox.css";
---

<BaseLayout
  title="工具箱｜abinzhao"
  description="开发、文本、设计与 AI 提效工具。所有输入默认只在浏览器本地处理。"
  canonicalPath="/toolbox/"
  cosmicVariant="toolbox"
>
  <div class="toolbox-page" data-toolbox-catalog>
    <header class="compact-page-header">
      <div>
        <p class="compact-page-header__eyebrow">LOCAL-FIRST / ZERO UPLOAD</p>
        <h1>工具箱</h1>
      </div>
      <p class="compact-page-header__summary">
        {toolboxTools.length} 个开发、文本、设计与 AI 工具。所有输入默认只在浏览器本地处理。
      </p>
    </header>

    <div class="toolbox-catalog__controls">
      <label class="toolbox-search">
        <span class="sr-only">搜索工具</span>
        <input
          type="search"
          name="tool-search"
          placeholder="搜索工具，例如 JSON、颜色、Prompt…"
          data-tool-search
        />
      </label>
      <div class="toolbox-categories" role="group" aria-label="按工具类型筛选">
        <button
          type="button"
          data-tool-group-filter="all"
          aria-pressed="true"
        >
          全部
        </button>
        {
          toolboxGroups.map((group) => (
            <button
              type="button"
              data-tool-group-filter={group.id}
              aria-pressed="false"
            >
              {group.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      toolboxGroups.map((group) => {
        const tools = toolboxTools.filter((tool) => tool.group === group.id);
        return (
          <section
            class="toolbox-group"
            data-toolbox-group={group.id}
            aria-labelledby={`toolbox-${group.id}`}
          >
            <div class="toolbox-group__head">
              <h2 id={`toolbox-${group.id}`}>{group.label}</h2>
              <p>{group.description}</p>
            </div>
            <div class="toolbox-grid">
              {tools.map((tool) => <ToolCard tool={tool} />)}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<script>
  import "@/scripts/toolbox-catalog";
</script>
