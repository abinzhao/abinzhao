---
import { getCollection } from "astro:content";
import ExperimentCard from "@/components/playground/ExperimentCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/playground.css";

const experiments = (
  await getCollection("playground", ({ data }) => !data.draft)
).sort(
  (left, right) =>
    Number(right.data.featured) - Number(left.data.featured) ||
    right.data.date.getTime() - left.data.date.getTime() ||
    left.data.title.localeCompare(right.data.title, "zh-CN"),
);
---

<BaseLayout
  title="实验室｜abinzhao"
  description="粒子、着色器与物理模拟组成的创意代码实验室。"
  canonicalPath="/playground/"
  cosmicVariant="playground"
>
  <main class="playground-index">
    <header class="playground-workbench-header">
      <div>
        <p class="playground-eyebrow">OPEN LAB / {String(experiments.length).padStart(2, "0")}</p>
        <h1>实验室</h1>
      </div>
      <p>
        运行中的图形、物理与交互系统。每个实验都保留原理说明、性能边界和静态降级。
      </p>
    </header>

    <section class="playground-catalog" aria-labelledby="experiment-list-title">
      <header class="playground-catalog__heading">
        <p>LIVE TRANSMISSIONS</p>
        <h2 id="experiment-list-title">选择一个系统开始运行</h2>
      </header>
      <div class="experiment-grid">
        {
          experiments.map((experiment, index) => (
            <ExperimentCard experiment={experiment} index={index} />
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
