---
import { getCollection } from "astro:content";
import ExperimentCard from "@/components/playground/ExperimentCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/cinematic-content.css";

const experiments = (
  await getCollection("playground", ({ data }) => !data.draft)
).sort(
  (left, right) =>
    Number(right.data.featured) - Number(left.data.featured) ||
    right.data.date.getTime() - left.data.date.getTime() ||
    left.data.title.localeCompare(right.data.title, "zh-CN"),
);
---

<BaseLayout
  title="实验室｜abinzhao"
  description="粒子、着色器与物理模拟组成的创意代码实验室。"
  canonicalPath="/playground/"
  cosmicVariant="playground"
>
  <header class="playground-hero">
    <p class="playground-hero__eyebrow">OPEN LAB / LIVE SYSTEMS</p>
    <h1>让代码脱离文档，<br />开始运动。</h1>
    <p>
      三个围绕图形、交互与实时系统的公开实验。每个实验都保留原理说明、性能边界和静态降级。
    </p>
  </header>

  <section class="playground-list" aria-labelledby="experiment-list-title">
    <header class="playground-list__heading">
      <p>TRANSMISSIONS</p>
      <h2 id="experiment-list-title">实验信号</h2>
    </header>
    <div class="experiment-grid">
      {
        experiments.map((experiment, index) => (
          <ExperimentCard experiment={experiment} index={index} />
        ))
      }
    </div>
  </section>
</BaseLayout>
