---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPersonJsonLd } from "@/lib/seo";
import { site } from "@/lib/site";
import "@/styles/cinematic-content.css";

const technologyGroups = [
  { title: "前端", items: ["TypeScript", "React", "JavaScript", "Astro"] },
  { title: "后端", items: ["Node.js"] },
  { title: "鸿蒙", items: ["HarmonyOS", "ArkTS", "ArkUI"] },
  { title: "小程序", items: ["小程序"] },
  { title: "跨端", items: ["跨端应用", "移动端", "PC 端"] },
  { title: "工具", items: ["CLI", "Monorepo", "AI Agent"] },
] as const;

const principles = [
  "从真实问题和约束出发，而不是从技术名词出发。",
  "优先建立可验证的交付闭环，再扩展复杂度。",
  "保持实现边界清晰，让跨端体验一致但不机械复制。",
] as const;

const nowDoing = [
  {
    label: "在写",
    value: "HarmonyOS Next 学习路径与前端经验迁移",
  },
  {
    label: "在做",
    value: "用 Astro 维护一个内容优先、可长期演进的个人站",
  },
  {
    label: "在思考",
    value: "AI 能力如何进入应用，而不是停留在演示界面",
  },
] as const;
---

<BaseLayout
  title={`关于${site.owner}｜${site.name}`}
  description="阿斌的技术方向、工作原则与公开联系入口。"
  jsonLd={buildPersonJsonLd()}
  cosmicVariant="about"
>
  <article class="about-page">
    <header class="compact-page-header">
      <div>
        <p class="compact-page-header__eyebrow">ABOUT / PROFILE</p>
        <h1>关于{site.owner}</h1>
      </div>
      <p class="compact-page-header__summary">
        前端 · 鸿蒙 · AI。认真对待技术，也认真对待长期关系。
      </p>
    </header>

    <section class="about-overview" aria-labelledby="about-profile-title">
      <div class="about-profile">
        <p>ENGINEER / CREATOR</p>
        <h2 id="about-profile-title">{site.owner}</h2>
        <p>
          以网页工程为根基，持续学习 HarmonyOS，并关注 AI
          能力如何成为可交付、可维护的应用体验。
        </p>
        <span>{site.nickname}</span>
      </div>
      <dl class="about-now">
        {
          nowDoing.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="about-section" aria-labelledby="technology-title">
      <div class="section-heading">
        <p>01 / TECHNOLOGY</p>
        <h2 id="technology-title">技术坐标</h2>
      </div>
      <div class="technology-grid">
        {
          technologyGroups.map((group, index) => (
            <section class="technology-group">
              <span aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section class="about-section principles" aria-labelledby="principles-title">
      <div class="section-heading">
        <p>02 / PRINCIPLES</p>
        <h2 id="principles-title">工作原则</h2>
      </div>
      <ol>
        {
          principles.map((principle, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{principle}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about-section contact" id="contact" aria-labelledby="contact-title">
      <div class="section-heading">
        <p>03 / CONTACT</p>
        <h2 id="contact-title">保持联系</h2>
      </div>
      <div class="contact-copy">
        <p>公开项目与技术内容都从这里继续。</p>
        <nav aria-label="联系入口">
          {
            site.social.map((item) => (
              <a href={item.href} target="_blank" rel="me noreferrer">
                <span>{item.label}</span>
                <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </nav>
      </div>
    </section>
  </article>
</BaseLayout>
