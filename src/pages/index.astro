---
import { getCollection } from "astro:content";
import FeaturedProjects from "@/components/home/FeaturedProjects.astro";
import Hero from "@/components/home/Hero.astro";
import LatestBlog from "@/components/home/LatestBlog.astro";
import PlaygroundPreview from "@/components/home/PlaygroundPreview.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortProjects } from "@/lib/content";
import { buildPersonJsonLd } from "@/lib/seo";
import { withBase } from "@/lib/site";
import "@/styles/home.css";

const projects = sortProjects(
  (await getCollection("projects", ({ data }) => !data.draft)).map(
    (entry) => ({ ...entry, slug: entry.data.slug }),
  ),
).slice(0, 3);
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const experiments = (
  await getCollection("playground", ({ data }) => !data.draft)
)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.date.valueOf() - a.data.date.valueOf() ||
      a.data.slug.localeCompare(b.data.slug, "zh-CN"),
  )
  .slice(0, 3);

const personJsonLd = buildPersonJsonLd();
---

<BaseLayout jsonLd={personJsonLd} cosmicVariant="home">
  <Hero />
  <FeaturedProjects projects={projects} />
  <LatestBlog entries={posts} />
  <PlaygroundPreview experiments={experiments} />
  <section
    class="home-section home-about"
    id="about"
    data-home-section
    aria-labelledby="home-about-title"
  >
    <p class="home-kicker">ABOUT / 04</p>
    <h2 id="home-about-title">还想知道更多？</h2>
    <p>
      这里收集的是公开项目、技术文章和持续进行的实验。关于我如何思考、构建和保持好奇，可以从下一页继续。
    </p>
    <a href={withBase("/about/")}>认识赵建斌 <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
