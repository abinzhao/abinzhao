---
import type { CollectionEntry } from "astro:content";
import { getReadingMinutes } from "@/lib/content";
import { withBase } from "@/lib/site";

interface Props {
  entries: CollectionEntry<"blog">[];
}

const { entries } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: "UTC",
});
---

<section
  class="home-section home-blog"
  id="latest-blog"
  data-home-section
  aria-labelledby="latest-blog-title"
>
  <header class="home-section__header">
    <div>
      <p class="home-kicker">WRITING / 01</p>
      <h2 id="latest-blog-title">最新文章</h2>
    </div>
    <p>只列出标题和必要信息。文章本身负责说服你继续读下去。</p>
  </header>

  <div class="home-blog__list">
    {
      entries.map((entry) => (
        <article class="home-post" data-home-post>
          <div class="home-post__meta">
            <span>{entry.data.category}</span>
            <time datetime={entry.data.date.toISOString()}>
              {dateFormatter.format(entry.data.date)}
            </time>
            <span>{getReadingMinutes(entry.body ?? "")} 分钟</span>
          </div>
          <h3>
            <a href={withBase(`/blog/${entry.data.slug}/`)}>
              {entry.data.title}
            </a>
          </h3>
          <ul class="home-post__tags" aria-label="文章标签">
            {entry.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
          </ul>
        </article>
      ))
    }
  </div>

  <a class="home-text-link" href={withBase("/blog/")}>浏览全部文章 <span>→</span></a>
</section>
