---
import { withBase } from "@/lib/site";
---

<section
  class="hero"
  id="hero"
  data-home-section
  data-hero
  data-scene-state="loading"
  aria-labelledby="hero-title"
>
  <div class="hero__copy">
    <p class="hero__eyebrow">赵建斌 / 开发者与实验者</p>
    <h1 id="hero-title" aria-label="把复杂，做得有意思。">
      把复杂，做得<strong>有意思。</strong>
    </h1>
    <p class="hero__intro">
      构建前端、鸿蒙与跨端体验，也把技术实验、生活观察和没做完的好奇心留在这里。
    </p>
    <div class="hero__actions">
      <a class="hero__primary-action" href={withBase("/projects/")}>查看项目</a>
      <a class="hero__secondary-action" href={withBase("/playground/")}>进入实验室</a>
    </div>
  </div>

  <div class="hero__visual" aria-hidden="true">
    <div class="hero__fallback">
      <span class="hero__planet"></span>
      <span class="hero__orbit hero__orbit--one"></span>
      <span class="hero__orbit hero__orbit--two"></span>
      <span class="hero__monogram">ZJB</span>
    </div>
    <canvas data-hero-scene></canvas>
  </div>

  <span class="hero__sticker">BUILD · BREAK · LEARN</span>
  <nav class="hero__quick-links" aria-label="首页快速入口">
    <a href={withBase("/about/")}>01 关于</a>
    <a href={withBase("/projects/")}>02 项目</a>
    <a href={withBase("/blog/")}>03 博客</a>
    <a href={withBase("/playground/")}>04 实验室</a>
  </nav>
</section>

<script>
  import { initHeroScene } from "@/scripts/scenes/hero";
  import { initHomeTransitions } from "@/scripts/transitions";

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const canvas = hero?.querySelector<HTMLCanvasElement>("[data-hero-scene]");
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (hero && canvas) {
    if (reducedMotion) {
      canvas.remove();
      hero.dataset.sceneState = "static";
    } else {
      void initHeroScene(hero, canvas);
      void initHomeTransitions(hero);
    }
  }
</script>
