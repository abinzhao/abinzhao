---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<section
  class="experiment-shell"
  data-experiment-shell
  data-experiment={slug}
  data-state="idle"
  aria-labelledby="experiment-status-title"
>
  <header class="experiment-shell__status">
    <div>
      <p class="experiment-shell__eyebrow">RUNTIME SIGNAL</p>
      <h2 id="experiment-status-title">实验状态</h2>
    </div>
    <p data-experiment-status aria-live="polite">
      需要 JavaScript 才能启动交互实验
    </p>
  </header>

  <div class="experiment-shell__controls" aria-label="实验控制">
    <button type="button" data-experiment-action="pause" disabled>
      暂停实验
    </button>
    <button type="button" data-experiment-action="resume" disabled>
      继续实验
    </button>
    <button type="button" data-experiment-action="reset" disabled>
      重置实验
    </button>
    <button type="button" data-experiment-retry hidden>
      重试实验
    </button>
    <div data-experiment-controls></div>
  </div>

  <div class:list={["experiment-shell__stage", `experiment-visual--${slug}`]}>
    <canvas data-experiment-canvas aria-hidden="true"></canvas>
    <div class="experiment-shell__fallback" aria-hidden="true">
      <span></span>
    </div>
  </div>

  <noscript>
    <p class="experiment-shell__noscript">
      需要 JavaScript 才能启动交互实验；实验说明和页面导航仍可正常使用。
    </p>
  </noscript>
</section>

<script>
  import {
    experimentLoaders,
    type ExperimentSlug,
  } from "@/scripts/scenes/registry";
  import { createExperimentRuntime } from "@/scripts/scenes/runtime";

  for (const shell of document.querySelectorAll<HTMLElement>(
    "[data-experiment-shell]",
  )) {
    const slug = shell.dataset.experiment as ExperimentSlug;
    const loader = experimentLoaders[slug];

    if (!loader) {
      shell.dataset.state = "error";
      const status = shell.querySelector<HTMLElement>(
        "[data-experiment-status]",
      );
      if (status) status.textContent = "实验未能启动。实验标识不在注册表中。";
      continue;
    }

    const runtime = createExperimentRuntime(shell, loader);
    void runtime.start();
  }
</script>
