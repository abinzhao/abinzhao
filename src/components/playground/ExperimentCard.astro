---
import type { CollectionEntry } from "astro:content";
import { withBase } from "@/lib/site";

interface Props {
  experiment: CollectionEntry<"playground">;
  index: number;
  locale?: "zh-CN" | "en";
}

const { experiment, index, locale = "zh-CN" } = Astro.props;
const { title, slug, description, tech } = experiment.data;
const isEnglish = locale === "en";
const openLabel = isEnglish ? `Open experiment: ${title}` : `打开实验：${title}`;
const techLabel = isEnglish ? `${title} technologies` : `${title}技术标签`;
---

<article
  class:list={["experiment-card", { "experiment-card--featured": index === 0 }]}
  data-experiment-card
>
  <a
    class:list={[
      "experiment-card__visual",
      `experiment-visual--${slug}`,
    ]}
    href={withBase(`/playground/${slug}/`)}
    aria-label={openLabel}
  >
    <span aria-hidden="true"></span>
  </a>

  <div class="experiment-card__body">
    <p class="experiment-card__index">
      {String(index + 1).padStart(2, "0")} / OPEN LAB
    </p>
    <h2>
      <a href={withBase(`/playground/${slug}/`)}>{title}</a>
    </h2>
    <p>{description}</p>
    <ul aria-label={techLabel}>
      {tech.map((item) => <li>{item}</li>)}
    </ul>
    <a class="experiment-card__action" href={withBase(`/playground/${slug}/`)}>
      {isEnglish ? "Launch experiment" : "进入实验"}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
