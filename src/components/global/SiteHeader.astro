---
import { site } from "@/lib/site";
import {
  localeFromPath,
  localizedPath,
  switchLocalePath,
} from "@/lib/i18n";
import { withoutBase } from "@/lib/site";
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle.astro";

const locale = localeFromPath(Astro.url.pathname);
const navigation =
  locale === "en"
    ? [
        "Home",
        "Projects",
        "Writing",
        "Lab",
        "Toolbox",
        "About",
      ]
    : site.navigation.map((item) => item.label);
const localeHref = switchLocalePath(
  Astro.url.pathname,
  locale === "en" ? "zh" : "en",
);
---

<header class="site-header" data-site-header data-scrolled="false">
  <div class="site-header__inner">
    <BrandMark />

    <nav class="desktop-navigation" aria-label="主导航">
      {
        site.navigation.map((item, index) => {
          const href = localizedPath(withoutBase(item.href), locale);
          return (
          <a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>
            {navigation[index]}
          </a>
        )})
      }
    </nav>

    <div class="site-header__actions">
      <a class="language-toggle" href={localeHref} lang={locale === "en" ? "zh-CN" : "en"}>
        {locale === "en" ? "中" : "EN"}
      </a>
      <ThemeToggle />
      <button
        class="command-toggle"
        type="button"
        aria-label="打开搜索与命令"
        data-command-open
      >
        <span aria-hidden="true">⌕</span>
        <kbd>⌘K</kbd>
      </button>
      <a
        class="github-link"
        href="https://github.com/abinzhao"
        rel="me noreferrer"
        target="_blank"
      >
        GitHub
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-label="打开菜单"
        aria-controls="mobile-navigation"
        aria-expanded="false"
        data-menu-toggle
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav
    class="mobile-navigation"
    id="mobile-navigation"
    aria-label="移动端主导航"
    data-mobile-navigation
  >
    {
      site.navigation.map((item, index) => {
        const href = localizedPath(withoutBase(item.href), locale);
        return (
        <a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>
          {navigation[index]}
        </a>
      )})
    }
  </nav>
</header>

<script>
  import { initNavigation } from "@/scripts/navigation";

  initNavigation();
</script>
