---
import type { CollectionEntry } from "astro:content";
import { withBase } from "@/lib/site";

interface Props {
  previous?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
}

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav class="article-pager" aria-label="文章翻页">
      {previous ? (
        <a href={withBase(`/blog/${previous.data.slug}/`)}>
          <span>上一篇</span>
          <strong>{previous.data.title}</strong>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={withBase(`/blog/${next.data.slug}/`)}>
          <span>下一篇</span>
          <strong>{next.data.title}</strong>
        </a>
      )}
    </nav>
  )
}
