---
import type { CollectionEntry } from "astro:content";
import { projectCategoryLabels } from "@/lib/content";
import { withBase } from "@/lib/site";

interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
  index: number;
}

const { project, featured = false, index } = Astro.props;
const { title, slug, summary, category, tags, repositoryUrl, role, status } =
  project.data;
const statusLabels = {
  completed: "已完成",
  ongoing: "持续维护",
  archived: "已归档",
} as const;
---

<article
  class:list={[
    "project-card",
    "fluid-card",
    { "project-card--featured": featured },
  ]}
  data-project-category={category}
>
  <span class="project-card__coordinate" aria-hidden="true">
    NODE / {String(index + 1).padStart(2, "0")}
  </span>
  <div class="project-card__signal" aria-hidden="true"></div>
  <div class="project-card__content">
    <p class="project-card__category">{projectCategoryLabels[category]}</p>
    <h3>{title}</h3>
    <p class="project-card__summary">{summary}</p>
    <ul class="project-card__tags" aria-label="技术标签">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
  <div class="project-card__actions">
    <a
      class="project-card__primary-link"
      href={withBase(`/projects/${slug}/`)}
      aria-label={`查看项目：${title}`}
    >
      查看项目
    </a>
    <a
      class="project-card__repository-link"
      href={repositoryUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub <span aria-hidden="true">↗</span>
    </a>
  </div>
  <details class="project-card__boundary">
    <summary>查看工程边界</summary>
    <dl>
      <div>
        <dt>公开身份</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt>当前状态</dt>
        <dd>{statusLabels[status]}</dd>
      </div>
      <div>
        <dt>可验证来源</dt>
        <dd><a href={repositoryUrl}>GitHub 仓库</a></dd>
      </div>
    </dl>
  </details>
</article>
