{
  "name": "fullstack-blog-course",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev:api": "tsx watch api/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "migrate": "tsx api/migrate.ts",
    "check": "tsc -p tsconfig.api.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "tsc -p tsconfig.api.json && vite build",
    "start:api": "node dist-api/server.js",
    "verify:security": "tsx scripts/security-check.ts",
    "verify:api": "tsx scripts/api-check.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
