<view class="page">
  <view class="panel">
    <text class="heading">预约创建与恢复</text>
    <text class="notice">端侧教学项目。所有记录只保存在当前设备，不代表真实预约、库存或付款。</text>
    <text class="label">服务</text>
    <picker range="{{services}}" range-key="name" value="{{serviceIndex}}"
      disabled="{{busy || blocked}}" bindchange="service">
      <view class="field">{{services[serviceIndex].name}}</view>
    </picker>
    <text class="label">日期，今天起 30 天内</text>
    <picker mode="date" value="{{day}}" start="{{startDay}}" end="{{endDay}}"
      disabled="{{busy || blocked}}" bindchange="day">
      <view class="field">{{day}}</view>
    </picker>
    <text class="label">时段</text>
    <picker range="{{slots}}" value="{{slotIndex}}" disabled="{{busy || blocked}}" bindchange="slot">
      <view class="field">{{slots[slotIndex]}}</view>
    </picker>
    <text class="label">备注，可不填写</text>
    <textarea class="field note" value="{{note}}" maxlength="-1"
      disabled="{{busy || blocked}}" bindinput="note" placeholder="请勿填写敏感信息" />
    <text class="message">{{message}}</text>
    <button type="primary" loading="{{busy}}" disabled="{{busy || blocked}}" bindtap="create">
      创建本地练习记录
    </button>
    <button wx:if="{{blocked}}" bindtap="reload">重试读取</button>
  </view>
  <view class="panel">
    <text class="heading">当前设备记录（{{rows.length}}）</text>
    <text wx:if="{{!rows.length}}" class="notice">暂无可显示记录</text>
    <view wx:for="{{rows}}" wx:key="id" class="record">
      <text class="service">{{item.serviceName}}</text>
      <text class="detail">{{item.day}} {{item.slot}} · {{item.statusLabel}}</text>
      <text wx:if="{{item.note}}" class="detail">备注：{{item.note}}</text>
      <button wx:if="{{item.status === 'active'}}" data-id="{{item.id}}"
        disabled="{{busy || blocked}}" bindtap="cancel">取消此本地记录</button>
    </view>
    <button disabled="{{busy}}" bindtap="clear">清除本地练习数据</button>
  </view>
</view>
