{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "exclude": [
    "app",
    "components",
    "content",
    "lib",
    "tests/*.ts",
    "tests/*.tsx",
    "next-env.d.ts",
